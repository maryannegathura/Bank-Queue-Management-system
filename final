#include <iostream>
#include <stdexcept>
using namespace std;

// --- Node Class (from teammate's Queue.h) ---
template <typename T>
class Node {
public:
    T data;
    Node<T>* next;

    Node(T value) {
        data = value;
        next = nullptr;
    }
};

// --- Queue Class (from teammate's Queue.h) ---
template <typename T>
class Queue {
private:
    Node<T>* frontNode;
    Node<T>* rearNode;
    int count;

public:
    Queue() {
        frontNode = nullptr;
        rearNode = nullptr;
        count = 0;
    }

    ~Queue() {
        while (!isEmpty()) {
            dequeue();
        }
    }

    void enqueue(T value) {
        Node<T>* newNode = new Node<T>(value);
        if (isEmpty()) {
            frontNode = newNode;
            rearNode = newNode;
        } else {
            rearNode->next = newNode;
            rearNode = newNode;
        }
        count++;
    }

    T dequeue() {
        if (isEmpty()) {
            throw runtime_error("Cannot dequeue. The queue is empty.");
        }
        Node<T>* temp = frontNode;
        T value = temp->data;
        frontNode = frontNode->next;
        if (frontNode == nullptr) {
            rearNode = nullptr;
        }
        delete temp;
        count--;
        return value;
    }

    T front() {
        if (isEmpty()) {
            throw runtime_error("The queue is empty.");
        }
        return frontNode->data;
    }

    bool isEmpty() {
        return frontNode == nullptr;
    }

    int size() {
        return count;
    }

    void display() {
        if (isEmpty()) {
            cout << "The queue is empty." << endl;
            return;
        }
        Node<T>* current = frontNode;
        cout << "Queue: ";
        while (current != nullptr) {
            cout << current->data;
            if (current->next != nullptr) {
                cout << " -> ";
            }
            current = current->next;
        }
        cout << endl;
    }
};

